
{
	"name": "${localWorkspaceFolderBasename}",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "workspaceFolder": "/workspace/${localWorkspaceFolderBasename}",
    "mounts": [
        "source=${localWorkspaceFolder},target=/workspace/${localWorkspaceFolderBasename},type=bind",
		"source=${localEnv:SSH_AUTH_SOCK},target=/tmp/vscode-ssh-auth.sock,type=bind"
    ],
	"customizations": {
    	"vscode": {
      		"extensions": ["saryndor.atmel-c-project-generator",
			               "dbaeumer.vscode-eslint",
			               "actboy168.tasks",
						   "ms-vscode.cpptools",
					       "esbenp.prettier-vscode"]
    	}
  	},
	"runArgs": [
		"--name=avr-dev-${localWorkspaceFolderBasename}",
		"--userns=keep-id",
		"-v", "/dev/bus/usb:/dev/bus/usb"
	]
}
